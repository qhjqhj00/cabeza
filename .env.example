# Cabeza env-var conventions
#
# Every cabeza credential can be passed as an explicit kwarg (Agent(api_key=...),
# SearchTool(api_key=...), VisitTool(jina_api_key=...), etc.). When a kwarg is
# omitted, the library falls back to the env var(s) listed below.
#
# Cabeza itself does NOT auto-load this file — copy it to `.env`, fill in the
# values, then source it (`set -a; . .env; set +a`) or use python-dotenv /
# similar to populate os.environ before running.

# ---- LLM endpoints (used by `Agent(family=...)` when api_key is None) -------
# Each family looks up its conventional env var first; if neither the kwarg
# nor the env var is set, the api_key defaults to the literal string "EMPTY"
# (which is fine for local vLLM endpoints that don't need a key).

# family="deepseek"
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# family="gpt" or family="gpt_oss"
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# family="qwen"  (local vLLM usually needs no key; the literal "EMPTY" is fine)
QWEN_API_KEY=EMPTY
QWEN_BASE_URL=http://localhost:8001/v1

# family="glm"
GLM_API_KEY=
GLM_BASE_URL=

# family="kimi"
KIMI_API_KEY=
KIMI_BASE_URL=

# ---- Tool credentials ------------------------------------------------------

# SearchTool / GoogleScholarTool — official Serper API
SERPER_API_KEY=

# VisitTool — official Jina Reader API
JINA_API_KEY=

# ---- Datasets --------------------------------------------------------------
# Override the bundled data/ directory (must contain <name>/eval.jsonl).
# CABEZA_DATA_ROOT=/somewhere/else
